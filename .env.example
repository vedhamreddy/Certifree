# Copy to .env.local and fill in. Never commit .env.local.
# Without these, accounts are switched off and CertiFree runs local-only as before.

# Supabase project URL and anon (public) key: Project Settings -> API.
# These are read only on the server; the browser never receives them.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, used only to delete an account and its files.
# Never prefix it with NEXT_PUBLIC_ and never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The address people use to open the site (used in sign-in links).
SITE_URL=http://localhost:3000
